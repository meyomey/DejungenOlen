# Kopiere diese Datei zu .env und trage echte Werte ein
# .env wird NICHT ins Git-Repo committed (siehe .gitignore)

# PFLICHT – unbedingt ersetzen! Die ersten 20 Zeichen dieses Werts sind gleichzeitig der
# Token fuer die Cron-Endpunkte (/api/backup/trigger, /api/reminder/trigger). Wer den
# Beispielwert stehen laesst, hat den oeffentlich bekannten Token "hier-einen-zufaellig"
# (Audit 7, Build ao).
# Generieren mit: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=hier-einen-zufaelligen-schluessel-eintragen

# Optional: eigener Datenbankpfad (Standard: sqlite:///dejungen_olen.db)
DATABASE_URL=sqlite:///dejungen_olen.db

# Optional: auf true setzen wenn per HTTPS gehostet
HTTPS=true

# Optional: SMTP für E-Mail-Versand (Passwort-Reset, Backup-Benachrichtigungen)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.de
